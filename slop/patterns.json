{
  "_note": "slop/patterns_ko.md 의 기계 판독 버전. w(가중치)는 1~3. 내가 실제로 쓰는 표현은 slop/allow.txt 에 적어 예외 처리한다.",
  "patterns": [
    {"id": "summary-open", "cat": "구조", "w": 3, "rx": "^\\s*(결론적으로|요약하자면|정리하자면|정리하면|종합하면|마지막으로)", "note": "앞 내용을 다시 요약하는 결말"},
    {"id": "echo-question", "cat": "구조", "w": 2, "rx": "^\\s*(좋은 질문|좋은 접근|훌륭한|흥미로운 (질문|주제))", "note": "질문 칭찬/되풀이 서두"},
    {"id": "not-a-but-b", "cat": "구조", "w": 2, "rx": "(은|는|이|가) 단순(히|한) .{1,40}(이|가)? ?(아니라|아닌)", "note": "단순한 A가 아니라 B"},
    {"id": "not-a-but-b2", "cat": "구조", "w": 1, "rx": "(이|가) 아니라 .{1,30}(입니다|이다|ㅂ니다)\\.?", "note": "A가 아니라 B입니다 대조"},
    {"id": "it-is-important", "cat": "어휘", "w": 3, "rx": "(하는 것이|하는 게|함이) (매우 |가장 |무엇보다 )?중요(합니다|하다|하죠)", "note": "~하는 것이 중요합니다"},
    {"id": "can-be-said", "cat": "어휘", "w": 3, "rx": "(라고|다고) (할|볼) 수 (있습니다|있다|있죠)", "note": "~라고 할 수 있습니다"},
    {"id": "helps", "cat": "어휘", "w": 2, "rx": "에 (큰 |많은 )?도움이 (됩니다|된다|될 수 있)", "note": "~에 도움이 됩니다"},
    {"id": "recommend-polite", "cat": "어휘", "w": 2, "rx": "(추천드립니다|권장드립니다|해 보시는 것을 추천|해보시길 바랍니다)", "note": "과한 완충 권유"},
    {"id": "through-this", "cat": "어휘", "w": 2, "rx": "(이를 통해|이를 바탕으로|이에 따라)", "note": "이를 통해"},
    {"id": "moreover", "cat": "어휘", "w": 1, "rx": "(^|\\s)(또한|나아가|더불어|아울러)[, ]", "note": "또한/나아가/더불어 (문두)"},
    {"id": "various", "cat": "어휘", "w": 1, "rx": "다양한 (측면|요소|방법|관점|분야|방식)", "note": "다양한 ~"},
    {"id": "effectively", "cat": "어휘", "w": 1, "rx": "(효과적으로|효율적으로|원활(하게|한)|체계적으로|종합적으로|유기적으로)", "note": "뜬 부사"},
    {"id": "hype-adj", "cat": "어휘", "w": 2, "rx": "(혁신적인|획기적인|핵심적인|필수적인|강력한|탁월한|최적의|견고한 기반)", "note": "근거 없는 과장 형용사"},
    {"id": "dive-in", "cat": "어휘", "w": 2, "rx": "(살펴보겠습니다|알아보겠습니다|알아보도록 하겠습니다|짚어보겠습니다|함께 살펴)", "note": "안내형 서두"},
    {"id": "hope-helps", "cat": "어휘", "w": 3, "rx": "(도움이 되(었)?기를 바랍니다|도움이 되셨(기를|으면)|궁금한 점이 (있으|있다)면)", "note": "마무리 인사"},
    {"id": "landscape", "cat": "어휘", "w": 2, "rx": "(패러다임|시너지|생태계|지평|여정|발판|토대를 마련)", "note": "거창한 명사"},
    {"id": "balance", "cat": "내용", "w": 1, "rx": "(물론|다만|한편으로는) .{1,60}(할 필요가 있습니다|고려해야 합니다|유의해야 합니다)", "note": "균형 맞추기 단서"},
    {"id": "emoji-lead", "cat": "부호", "w": 2, "rx": "^\\s*([-*]\\s*)?[\\U0001F300-\\U0001FAFF\\u2600-\\u27BF]", "note": "이모지로 시작하는 줄"},
    {"id": "emdash", "cat": "부호", "w": 1, "rx": "[—–]", "note": "줄표"},
    {"id": "bold-label", "cat": "구조", "w": 1, "rx": "^\\s*([-*]|\\d+\\.)\\s+\\*\\*[^*]+\\*\\*\\s*[:：-]", "note": "불릿 + **굵은 라벨**: 설명"}
  ]
}
